<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    tools:context=".ItemDetailsActivity">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?colorSurface"
        android:elevation="@dimen/card_elevation"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Product Details"
        app:titleTextColor="?colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Product Image -->
            <ImageView
                android:id="@+id/itemImageDetail"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:background="?colorSurfaceVariant"
                android:scaleType="centerCrop"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <!-- Product Details Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.App.CardView.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                app:cardCornerRadius="@dimen/spacing_lg">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <!-- Product Name -->
                    <TextView
                        android:id="@+id/itemNameDetail"
                        style="@style/TextAppearance.App.HeadlineMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="Product Name"
                        android:textAlignment="center"
                        android:textColor="?colorOnSurface" />

                    <!-- Quantity Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_lg"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/quantityLabel"
                            style="@style/TextAppearance.App.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/spacing_md"
                            android:text="Quantity"
                            android:textColor="?colorOnSurface" />

                        <!-- Quantity Controls -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/button_outline"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_xs">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/decreaseButton"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="@dimen/icon_size_medium"
                                android:layout_height="@dimen/icon_size_medium"
                                app:icon="@drawable/ic_remove"
                                app:iconSize="@dimen/icon_size_small"
                                app:iconTint="?colorOnSurface" />

                            <TextView
                                android:id="@+id/quantityText"
                                style="@style/TextAppearance.App.TitleMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginHorizontal="@dimen/spacing_sm"
                                android:minWidth="32dp"
                                android:gravity="center"
                                android:text="1"
                                android:textColor="?colorOnSurface" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/increaseButton"
                                style="@style/Widget.Material3.Button.IconButton"
                                android:layout_width="@dimen/icon_size_medium"
                                android:layout_height="@dimen/icon_size_medium"
                                app:icon="@drawable/ic_add"
                                app:iconSize="@dimen/icon_size_small"
                                app:iconTint="?colorOnSurface" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Description Section -->
                    <TextView
                        android:id="@+id/descriptionLabel"
                        style="@style/TextAppearance.App.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="Description"
                        android:textColor="?colorOnSurface" />

                    <TextView
                        android:id="@+id/itemDescriptionDetail"
                        style="@style/TextAppearance.App.BodyLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_xl"
                        android:text="Product description will appear here"
                        android:textColor="?colorOnSurfaceVariant" />

                    <!-- Action Section -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.App.CardView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?colorPrimaryContainer">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_lg">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/orderButton"
                                style="@style/Widget.App.Button"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Add To Cart" />

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:layout_marginHorizontal="@dimen/spacing_md"
                                android:background="?colorOutline" />

                            <TextView
                                android:id="@+id/itemPriceDetail"
                                style="@style/TextAppearance.App.TitleLarge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="$0.00"
                                android:textColor="?colorPrimary" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>