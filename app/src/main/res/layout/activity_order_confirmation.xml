<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?colorSurface"
        android:elevation="@dimen/card_elevation"
        app:layout_constraintTop_toTopOf="parent"
        app:title="Order Confirmation"
        app:titleTextColor="?colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/buttonLayout"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_lg">

            <!-- Success Icon -->
            <ImageView
                android:id="@+id/successIcon"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/spacing_lg"
                android:src="@drawable/ic_check_circle"
                app:tint="@color/success" />

            <!-- Success Title -->
            <TextView
                android:id="@+id/successTitle"
                style="@style/TextAppearance.App.HeadlineMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="@dimen/spacing_sm"
                android:text="Commande Réussie!"
                android:textColor="?colorOnSurface" />

            <!-- Success Message -->
            <TextView
                android:id="@+id/successMessage"
                style="@style/TextAppearance.App.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/spacing_xl"
                android:gravity="center"
                android:text="Merci pour votre commande. Vous recevrez des notifications lorsque le statut de votre commande changera."
                android:textColor="?colorOnSurfaceVariant" />

            <!-- Order Details Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/orderDetailsCard"
                style="@style/Widget.App.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_lg">

                    <TextView
                        style="@style/TextAppearance.App.TitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:text="Détails de la commande"
                        android:textColor="?colorOnSurface" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginBottom="@dimen/spacing_md"
                        android:background="?colorOutline" />

                    <TextView
                        android:id="@+id/orderIdText"
                        style="@style/TextAppearance.App.BodyLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="Commande #123456"
                        android:textColor="?colorOnSurface" />

                    <TextView
                        android:id="@+id/dateText"
                        style="@style/TextAppearance.App.BodyLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="31 mars 2025, 11:36"
                        android:textColor="?colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/statusText"
                        style="@style/TextAppearance.App.BodyLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="Statut: En attente"
                        android:textColor="?colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/itemCountText"
                        style="@style/TextAppearance.App.BodyLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/spacing_sm"
                        android:text="3 articles"
                        android:textColor="?colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/totalText"
                        style="@style/TextAppearance.App.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Total: $123.45"
                        android:textColor="?colorPrimary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/spacing_lg"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/continueShoppingButton"
            style="@style/Widget.App.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="Continuer les achats" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/viewOrdersButton"
            style="@style/Widget.App.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_sm"
            android:layout_weight="1"
            android:text="Voir mes commandes" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>